{
  "name": "shopsphere-desktop",
  "version": "0.1.0",
  "description": "ShopSphere desktop app (Electron shell around the ShopSphere web app)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "sg.shopsphere.desktop",
    "productName": "ShopSphere",
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
