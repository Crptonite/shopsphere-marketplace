# ShopSphere environment template — NAMES ONLY. Never commit real values.
# Copy to .env.local and fill in. Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL (authoritative database, pgvector)
DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_SSL=true

# Supabase (Auth + Storage only — choose ONE project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# Comma-separated emails that get admin access (e.g. /admin/discovery)
ADMIN_EMAILS=

# Redis (optional: search cache, quote cache, badge counts)
REDIS_URL=

# AI (optional)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Product discovery (optional)
SERP_API_KEY=

# Stripe — TEST MODE keys only (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Notifications (optional)
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Market data for the finance dashboard (optional)
FMP_API_KEY=
FINNHUB_API_KEY=

# Deferred / optional infrastructure
PINECONE_API_KEY=
PINECONE_INDEX=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Account switching: sealed sessions for accounts used in the last 2 hours (any long random string)
ACCOUNT_VAULT_KEY=
